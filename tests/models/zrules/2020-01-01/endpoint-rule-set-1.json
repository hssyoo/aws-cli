          "assign": "prefix"
        },
        {
          "fn": "uriEncode",
          "argv": [
            "a b/c"
          ],
          "assign": "encoded"
        },
        {
          "fn": "aws.parseArn",
          "argv": [
            "arn:aws:zrules:us-west-2:123456789012:gadget/g1"
