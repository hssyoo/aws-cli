          "assign": "gadget"
        },
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Bucket"
            }
          ]
        },
        {
          "fn": "aws.isVirtualHostableS3Bucket",
          "argv": [
            {
              "ref": "Bucket"
            },
            false
          ]
        }
      ],
      "rules": [
        {
          "type": "endpoint",
          "conditions": [],
          "endpoint": {
            "url": "https://{gadget}.{prefix}.zrules.{Region}.amazonaws.com",
            "headers": {},
            "properties": {
              "metricValues": [
                "zrules"
              ],
              "authSchemes": [
                {
                  "name": "sigv4a",
                  "signingName": "zrules",
                  "signingRegionSet": [
                    "*"
                  ],
                  "disableDoubleEncoding": true
