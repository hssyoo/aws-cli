{
  "version": "1.0",
  "parameters": {
    "Region": {
      "required": false,
      "type": "String",
      "builtIn": "AWS::Region",
      "documentation": "The region."
    },
    "UseFIPS": {
      "required": true,
      "type": "Boolean",
      "builtIn": "AWS::UseFIPS",
      "default": false,
      "documentation": "FIPS."
    },
    "UseDualStack": {
      "required": true,
      "type": "Boolean",
      "builtIn": "AWS::UseDualStack",
      "default": false,
      "documentation": "Dual-stack."
    },
    "Endpoint": {
      "required": false,
      "type": "String",
      "builtIn": "SDK::Endpoint",
      "documentation": "A custom endpoint."
    },
    "Owner": {
      "required": false,
      "type": "String",
      "documentation": "A context parameter."
    },
    "Marker": {
      "required": false,
      "type": "String",
      "documentation": "A context parameter."
    },
    "AccountId": {
      "required": false,
      "type": "String",
      "documentation": "A context parameter."
    },
    "WidgetName": {
      "required": false,
      "type": "String",
      "documentation": "A context parameter."
    }
  },
  "rules": [
    {
      "type": "endpoint",
      "conditions": [
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Endpoint"
            }
          ]
        }
      ],
      "endpoint": {
        "url": {
          "ref": "Endpoint"
        }
      }
    },
    {
      "type": "endpoint",
      "conditions": [
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Owner"
            }
          ]
        },
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Region"
            }
          ]
        }
      ],
      "endpoint": {
        "url": "https://{Owner}.owner.zrestxml.{Region}.amazonaws.com",
        "properties": {},
        "headers": {}
      }
    },
    {
      "type": "endpoint",
      "conditions": [
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Marker"
            }
          ]
        },
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Region"
            }
          ]
        }
      ],
      "endpoint": {
        "url": "https://marker.zrestxml.{Region}.amazonaws.com",
        "properties": {},
        "headers": {}
      }
    },
    {
      "type": "endpoint",
      "conditions": [
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "AccountId"
            }
          ]
        },
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Region"
            }
          ]
        }
      ],
      "endpoint": {
        "url": "https://account.zrestxml.{Region}.amazonaws.com",
        "properties": {},
        "headers": {}
      }
    },
    {
      "type": "endpoint",
      "conditions": [
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "WidgetName"
            }
          ]
        },
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Region"
            }
          ]
        }
      ],
      "endpoint": {
        "url": "https://{WidgetName}.widget.zrestxml.{Region}.amazonaws.com",
        "properties": {},
        "headers": {}
      }
    },
    {
      "type": "tree",
      "conditions": [
        {
          "fn": "isSet",
          "argv": [
            {
              "ref": "Region"
            }
          ]
        },
        {
          "fn": "aws.partition",
          "argv": [
            {
              "ref": "Region"
            }
          ],
          "assign": "PartitionResult"
        }
      ],
      "rules": [
        {
          "type": "endpoint",
          "conditions": [
            {
              "fn": "booleanEquals",
              "argv": [
                {
                  "ref": "UseFIPS"
                },
                true
              ]
            },
            {
              "fn": "booleanEquals",
              "argv": [
                {
                  "ref": "UseDualStack"
                },
                true
              ]
            }
          ],
          "endpoint": {
            "url": "https://zrestxml-fips.{Region}.{PartitionResult#dualStackDnsSuffix}"
          }
        },
        {
          "type": "endpoint",
          "conditions": [
            {
              "fn": "booleanEquals",
              "argv": [
                {
                  "ref": "UseFIPS"
                },
                true
              ]
            }
          ],
          "endpoint": {
            "url": "https://zrestxml-fips.{Region}.{PartitionResult#dnsSuffix}"
          }
        },
        {
          "type": "endpoint",
          "conditions": [
            {
              "fn": "booleanEquals",
              "argv": [
                {
                  "ref": "UseDualStack"
                },
                true
              ]
            }
          ],
          "endpoint": {
            "url": "https://zrestxml.{Region}.{PartitionResult#dualStackDnsSuffix}"
          }
        },
        {
          "type": "endpoint",
          "conditions": [],
          "endpoint": {
            "url": "https://zrestxml.{Region}.{PartitionResult#dnsSuffix}"
          }
        }
      ]
    },
    {
      "type": "error",
      "conditions": [],
      "error": "Invalid Configuration: Missing Region"
    }
  ]
}
