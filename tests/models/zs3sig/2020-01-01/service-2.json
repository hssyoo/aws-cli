{
  "version": "2.0",
  "metadata": {
    "apiVersion": "2020-01-01",
    "endpointPrefix": "zs3sig",
    "protocol": "rest-xml",
    "protocols": [
      "rest-xml"
    ],
    "serviceFullName": "Fake zs3sig",
    "serviceId": "Zs3sig",
    "signatureVersion": "s3",
    "uid": "zs3sig-2020-01-01",
    "auth": [
      "aws.auth#sigv4"
    ]
  },
  "operations": {
    "Note": {
      "name": "Note",
      "http": {
        "method": "POST",
        "requestUri": "/note"
      },
      "input": {
        "shape": "NoteInput",
        "locationName": "NoteRequest",
        "xmlNamespace": {
          "uri": "https://zs3sig.example.com/doc/"
        }
      },
      "output": {
        "shape": "NoteOutput"
      }
    },
    "PutKey": {
      "name": "PutKey",
      "http": {
        "method": "PUT",
        "requestUri": "/{Bucket}/{Key+}"
      },
      "input": {
        "shape": "PutKeyInput",
        "locationName": "PutKeyRequest",
        "xmlNamespace": {
          "uri": "https://zs3sig.example.com/doc/"
        }
      },
      "output": {
        "shape": "PutKeyOutput"
      }
    },
    "ListKeys": {
      "name": "ListKeys",
      "http": {
        "method": "GET",
        "requestUri": "/{Bucket}?list-type=2"
      },
      "input": {
        "shape": "ListKeysInput"
      },
      "output": {
        "shape": "ListKeysOutput"
      }
    }
  },
  "shapes": {
    "NoteInput": {
      "type": "structure",
      "members": {
        "Note": {
          "shape": "Text"
        }
      }
    },
    "NoteOutput": {
      "type": "structure",
      "members": {
        "Note": {
          "shape": "Text"
        }
      }
    },
    "Text": {
      "type": "string"
    },
    "PutKeyInput": {
      "type": "structure",
      "required": [
        "Bucket",
        "Key"
      ],
      "members": {
        "Bucket": {
          "shape": "Text",
          "location": "uri",
          "locationName": "Bucket"
        },
        "Key": {
          "shape": "Text",
          "location": "uri",
          "locationName": "Key"
        },
        "Tag": {
          "shape": "Text",
          "location": "header",
          "locationName": "x-amz-meta-tag"
        },
        "Note": {
          "shape": "Text"
        }
      }
    },
    "PutKeyOutput": {
      "type": "structure",
      "members": {
        "ETag": {
          "shape": "Text",
          "location": "header",
          "locationName": "ETag"
        }
      }
    },
    "ListKeysInput": {
      "type": "structure",
      "required": [
        "Bucket"
      ],
      "members": {
        "Bucket": {
          "shape": "Text",
          "location": "uri",
          "locationName": "Bucket"
        },
        "Prefix": {
          "shape": "Text",
          "location": "querystring",
          "locationName": "prefix"
        },
        "StartAfter": {
          "shape": "Text",
          "location": "querystring",
          "locationName": "start-after"
        },
        "MaxKeys": {
          "shape": "Count",
          "location": "querystring",
          "locationName": "max-keys"
        }
      }
    },
    "ListKeysOutput": {
      "type": "structure",
      "members": {
        "Keys": {
          "shape": "KeyList",
          "locationName": "Key"
        },
        "KeyCount": {
          "shape": "Count"
        }
      }
    },
    "KeyList": {
      "type": "list",
      "member": {
        "shape": "Text"
      },
      "flattened": true
    },
    "Count": {
      "type": "integer"
    }
  }
}
